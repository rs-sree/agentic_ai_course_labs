# Week 6 reuses Week 2's OpenAI key - no new key needed for the eval harness.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-your-key-here
# Qdrant runs locally in Docker (carried over from Week 5's access-control demo):
QDRANT_URL=http://localhost:6333
# Lab 12C - Langfuse, self-hosted locally in Docker (primary path: `docker
# compose up -d` in this folder auto-provisions the org/project/keys below,
# nothing to sign up for). These are NOT secrets - they're the fixed local
# keys docker-compose.yml provisions on every learner's own machine, never
# reachable outside 127.0.0.1:
LANGFUSE_PUBLIC_KEY=pk-lf-week6local0000000000000000
LANGFUSE_SECRET_KEY=sk-lf-week6local0000000000000000
LANGFUSE_HOST=http://localhost:3000
# Fallback, if your machine can't take a 6-container stack: Langfuse Cloud's
# free Hobby tier (50k observations/month, no card) at
# https://cloud.langfuse.com -> Settings -> API Keys. Same code either way -
# just replace the three lines above with your Cloud project's real keys and
# LANGFUSE_HOST=https://cloud.langfuse.com.
