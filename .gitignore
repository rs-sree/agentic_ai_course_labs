# ─────────────────────────────────────────────────────────────
# Secrets & environment — NEVER commit API keys or credentials
# ─────────────────────────────────────────────────────────────
# keep .env.example (template, no secrets); ignore .env and any real .env.<variant>
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
secrets.*
credentials.*
*_credentials*
*apikey*
*api_key*
*.secret

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
.virtualenv/

# ─────────────────────────────────────────────────────────────
# RAG build artifacts (regenerated by build_*.py — don't track)
# ─────────────────────────────────────────────────────────────
chunks.jsonl
*.faiss
*.faiss.chunks.json
index.faiss*
*.index

# Local vector DB / model caches
qdrant_storage/
.cache/
models/
*.bin
*.pt
*.pth
*.onnx
*.safetensors

# ─────────────────────────────────────────────────────────────
# Jupyter / data scratch
# ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
# OS & editor junk
# ─────────────────────────────────────────────────────────────
.DS_Store
__MACOSX/
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
