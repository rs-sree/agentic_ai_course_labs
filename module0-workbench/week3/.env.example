# === AI Workbench Configuration ===

# LLM Provider (currently: openai)
LLM_PROVIDER=openai

# Model to use (cost/capability tradeoff)
# Options: gpt-4.1-mini (cheap+fast), gpt-4.1 (powerful+expensive)
LLM_MODEL=gpt-4.1-mini

# Your OpenAI API key (get from: platform.openai.com/api-keys)
# NEVER commit the real value — only this template.
OPENAI_API_KEY=sk-your-key-here

# Where agent_teaser.py (Lab 3D) sends its tool calls.
# Local:    http://localhost:8000
# Deployed: http://<YOUR-EC2-PUBLIC-IP>:8000
API_URL=http://localhost:8000
